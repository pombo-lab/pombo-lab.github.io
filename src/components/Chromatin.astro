---
// The chromatin polymer from the original site, confined to a round "nucleus".
// It condenses and extends on a slow cycle; hover near a strand to pull it.
import { currentSites } from '../lib/data';

const hex = (c: string | undefined, fallback: number[]) => {
	const m = c?.match(/^#?([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i);
	return m ? m.slice(1).map((h) => parseInt(h, 16)) : fallback;
};
const colors = [hex(currentSites[0]?.color, [91, 134, 232]), hex(currentSites[1]?.color, [229, 164, 74])];
---

<div class="nucleus" aria-hidden="true">
	<canvas id="chromatin" data-colors={JSON.stringify(colors)}></canvas>
</div>

<style>
	.nucleus {
		--nucleus-bg: #f3f6fb;
		width: 300px;
		height: 300px;
		max-width: 100%;
		aspect-ratio: 1;
		margin: 0 auto;
		border-radius: 50%;
		background: radial-gradient(circle at 35% 30%, var(--color-bg) 0%, var(--nucleus-bg) 70%);
		border: 6px solid var(--color-bg);
		box-shadow: 0 0 0 1px var(--color-border), var(--shadow-lg);
		overflow: hidden;
	}
	:global([data-theme='dark']) .nucleus {
		--nucleus-bg: #16213a;
	}
	canvas {
		display: block;
		width: 100%;
		height: 100%;
	}
	@media (max-width: 768px) {
		.nucleus {
			width: 220px;
			height: 220px;
		}
	}
</style>

<script>
	const cv = document.getElementById('chromatin') as HTMLCanvasElement | null;
	if (cv) start(cv);

	function start(cv: HTMLCanvasElement) {
		const ctx = cv.getContext('2d')!;
		const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const [CA, CB] = JSON.parse(cv.dataset.colors || '[[91,134,232],[229,164,74]]') as number[][];

		const N = 110; // beads
		const PERIOD = 7200; // ms per condense → extend cycle
		const FOCAL = 900; // perspective focal length
		const GRAB_R = 46; // screen px: how close the cursor must come
		const SPAN = 6; // beads either side of the grabbed one

		type Bead = { x: number; y: number; z: number; vx: number; vy: number; vz: number; sx: number; sy: number; zv: number; sc: number };
		const beads: Bead[] = [];
		const ptr = { x: 0, y: 0, near: false };
		const grab = { i: -1, amt: 0 };

		let BG = [243, 246, 251];
		let w = 0, h = 0, rx = 0, ry = 0, rz = 0, L0 = 6;
		let raf = 0, t0 = 0, cond = 0.18;
		let yaw = 0.7, tilt = -0.15, cy = 1, sy = 0, ct = 1, st = 0;

		const clamp = (v: number, a: number, b: number) => (v < a ? a : v > b ? b : v);

		// Far strands fade toward the nucleus colour, which changes with the theme.
		function readBg() {
			const probe = getComputedStyle(cv.parentElement!).getPropertyValue('--nucleus-bg').trim();
			const m = probe.match(/^#([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i);
			if (m) BG = m.slice(1).map((x) => parseInt(x, 16));
		}

		function size() {
			const r = cv.getBoundingClientRect();
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			w = r.width;
			h = r.height;
			cv.width = Math.round(w * dpr);
			cv.height = Math.round(h * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			rx = w * 0.4;
			ry = h * 0.4;
			rz = Math.min(w, h) * 0.4;
			L0 = clamp(w / 48, 4.5, 7);
		}

		// Where bead i sits when the chain is fully extended: a spiral that
		// winds around the inside of the nucleus, pole to pole.
		const TURNS = 3.5;
		function target(i: number) {
			const t = i / (N - 1);
			const th = 0.25 + t * (Math.PI - 0.5);
			const ph = t * TURNS * Math.PI * 2;
			// Irregular radius so the path reads as chromatin, not a spring.
			const r = 0.7 + 0.16 * Math.sin(i * 0.9) + 0.1 * Math.sin(i * 2.3 + 1);
			const wob = 0.22 * Math.sin(i * 0.55);
			return {
				x: Math.sin(th) * Math.cos(ph + wob) * rx * r,
				y: (-Math.cos(th) + 0.12 * Math.sin(i * 1.3)) * ry * r,
				z: Math.sin(th) * Math.sin(ph + wob) * rz * r,
			};
		}

		// Centre the path so the chain doesn't drift to one side of the nucleus.
		let off = { x: 0, y: 0, z: 0 };
		function centre() {
			off = { x: 0, y: 0, z: 0 };
			const pts = Array.from({ length: N }, (_, i) => target(i));
			for (const p of pts) { off.x += p.x / N; off.y += p.y / N; off.z += p.z / N; }
		}

		function seed() {
			centre();
			beads.length = 0;
			for (let i = 0; i < N; i++) {
				const g = target(i);
				beads.push({ x: g.x - off.x, y: g.y - off.y, z: g.z - off.z, vx: 0, vy: 0, vz: 0, sx: 0, sy: 0, zv: 0, sc: 1 });
			}
		}

		function spin() {
			yaw += 0.0026 * (1 - 0.75 * grab.amt);
			tilt = -0.15 + Math.sin(yaw * 0.37) * 0.1;
			cy = Math.cos(yaw);
			sy = Math.sin(yaw);
			ct = Math.cos(tilt);
			st = Math.sin(tilt);
		}

		function project() {
			for (const p of beads) {
				const x1 = p.x * cy + p.z * sy;
				const z1 = -p.x * sy + p.z * cy;
				const y2 = p.y * ct - z1 * st;
				const z2 = p.y * st + z1 * ct;
				const s = FOCAL / (FOCAL + z2);
				p.zv = z2;
				p.sc = s;
				p.sx = w / 2 + x1 * s;
				p.sy = h / 2 + y2 * s;
			}
		}

		function unproject(dsx: number, dsy: number, s: number) {
			const dvx = dsx / s, dvy = dsy / s;
			const y1 = dvy * ct, z1 = -dvy * st;
			return { x: dvx * cy - z1 * sy, y: y1, z: dvx * sy + z1 * cy };
		}

		function updateGrab() {
			if (!ptr.near) {
				grab.amt += (0 - grab.amt) * 0.1;
				return;
			}
			let best = -1, bestD = GRAB_R * GRAB_R;
			if (grab.i >= 0) {
				const p = beads[grab.i];
				if ((ptr.x - p.sx) ** 2 + (ptr.y - p.sy) ** 2 < (GRAB_R * 1.6) ** 2) best = grab.i;
			}
			if (best < 0) {
				beads.forEach((p, i) => {
					const d = (ptr.x - p.sx) ** 2 + (ptr.y - p.sy) ** 2;
					if (d < bestD) { bestD = d; best = i; }
				});
			}
			grab.i = best;
			grab.amt += ((best >= 0 ? 1 : 0) - grab.amt) * 0.12;
			cv.style.cursor = best >= 0 && grab.amt > 0.4 ? 'grabbing' : '';
		}

		function step(now: number) {
			if (!still) {
				if (!t0) t0 = now;
				const raw = 0.5 - 0.5 * Math.cos(((now - t0) / PERIOD) * Math.PI * 2);
				cond = raw * raw * (3 - 2 * raw);
			}
			const ext = 1 - cond;
			const L = L0 * (0.6 + 0.64 * ext);
			const R = L * 1.9;

			let mx = 0, my = 0, mz = 0;
			for (const b of beads) { mx += b.x; my += b.y; mz += b.z; }
			mx /= N; my /= N; mz /= N;

			// bonds
			for (let i = 0; i < N - 1; i++) {
				const a = beads[i], b = beads[i + 1];
				let dx = b.x - a.x, dy = b.y - a.y, dz = b.z - a.z;
				const d = Math.sqrt(dx * dx + dy * dy + dz * dz) || 1e-6;
				const f = (d - L) * 0.19;
				dx /= d; dy /= d; dz /= d;
				a.vx += dx * f; a.vy += dy * f; a.vz += dz * f;
				b.vx -= dx * f; b.vy -= dy * f; b.vz -= dz * f;
			}

			// bending: stiff while extended, floppy while condensed
			const bend = 0.018 + 0.055 * ext;
			for (let i = 1; i < N - 1; i++) {
				const p = beads[i - 1], c = beads[i], n = beads[i + 1];
				c.vx += ((p.x + n.x) / 2 - c.x) * bend;
				c.vy += ((p.y + n.y) / 2 - c.y) * bend;
				c.vz += ((p.z + n.z) / 2 - c.z) * bend;
			}

			// excluded volume
			for (let i = 0; i < N; i++) {
				for (let j = i + 3; j < N; j++) {
					const a = beads[i], b = beads[j];
					let dx = b.x - a.x, dy = b.y - a.y, dz = b.z - a.z;
					const d2 = dx * dx + dy * dy + dz * dz;
					if (d2 < R * R && d2 > 1e-6) {
						const d = Math.sqrt(d2), f = (R - d) * 0.05;
						dx /= d; dy /= d; dz /= d;
						a.vx -= dx * f; a.vy -= dy * f; a.vz -= dz * f;
						b.vx += dx * f; b.vy += dy * f; b.vz += dz * f;
					}
				}
			}

			const grip = 0.03 * cond;
			const reach = 0.014 * ext;
			const heat = 0.3 + 0.45 * cond;
			beads.forEach((p, i) => {
				p.vx += (mx - p.x) * grip;
				p.vy += (my - p.y) * grip;
				p.vz += (mz - p.z) * grip;
				const g = target(i);
				p.vx += (g.x - off.x - p.x) * reach;
				p.vy += (g.y - off.y - p.y) * reach;
				p.vz += (g.z - off.z - p.z) * reach;
				p.vx += (Math.random() - 0.5) * heat;
				p.vy += (Math.random() - 0.5) * heat;
				p.vz += (Math.random() - 0.5) * heat;
			});

			// local drag: the grabbed stretch of chain, not the whole polymer
			if (grab.i >= 0 && grab.amt > 0.01) {
				const a = beads[grab.i];
				let dsx = ptr.x - a.sx, dsy = ptr.y - a.sy;
				const ds = Math.hypot(dsx, dsy);
				if (ds > 120) { dsx *= 120 / ds; dsy *= 120 / ds; }
				const g = unproject(dsx, dsy, a.sc);
				const pull = 0.03 * grab.amt;
				for (let k = -SPAN; k <= SPAN; k++) {
					const j = grab.i + k;
					if (j < 0 || j >= N) continue;
					const f = pull * (0.5 + 0.5 * Math.cos((Math.PI * k) / (SPAN + 1)));
					beads[j].vx += g.x * f;
					beads[j].vy += g.y * f;
					beads[j].vz += g.z * f;
				}
			}

			// spherical confinement (the nuclear envelope) + damping
			for (const p of beads) {
				const nx = p.x / rx, ny = p.y / ry, nz = p.z / rz;
				const r = Math.sqrt(nx * nx + ny * ny + nz * nz);
				if (r > 1) {
					const f = (r - 1) * 1.6;
					p.vx -= nx * f; p.vy -= ny * f; p.vz -= nz * f;
				}
				p.vx *= 0.9; p.vy *= 0.9; p.vz *= 0.9;
				p.x += p.vx; p.y += p.vy; p.z += p.vz;
			}
		}

		function draw() {
			ctx.clearRect(0, 0, w, h);
			const order: number[] = [];
			for (let i = 0; i < N - 1; i++) order.push(i);
			order.sort((a, b) => beads[b].zv + beads[b + 1].zv - (beads[a].zv + beads[a + 1].zv));
			const held = grab.amt > 0.05 && grab.i >= 0;
			ctx.lineCap = 'round';
			ctx.lineJoin = 'round';
			for (const glow of [true, false]) {
				for (const i of order) {
					const a = beads[i], b = beads[i + 1];
					const dep = clamp((rz - (a.zv + b.zv) / 2) / (2 * rz), 0, 1); // 1 near, 0 far
					const t = i / (N - 2);
					let hold = 0;
					if (held) {
						const k = Math.abs(i - grab.i);
						if (k <= SPAN) hold = grab.amt * (0.5 + 0.5 * Math.cos((Math.PI * k) / (SPAN + 1)));
					}
					const fade = (1 - dep) * 0.4;
					const col = [0, 1, 2].map((c) => {
						const base = CA[c] + (CB[c] - CA[c]) * t;
						return Math.round(base + (BG[c] - base) * fade);
					});
					const core = (2.6 - 0.8 * cond) * (0.55 + 0.8 * dep) * (1 + 0.45 * hold);
					ctx.strokeStyle = `rgb(${col.join(',')})`;
					ctx.lineWidth = glow ? core * 3.6 : core;
					ctx.globalAlpha = glow ? 0.06 + 0.06 * dep : (0.6 + 0.4 * dep) * (1 + 0.3 * hold);
					ctx.beginPath();
					ctx.moveTo(a.sx, a.sy);
					ctx.lineTo(b.sx, b.sy);
					ctx.stroke();
				}
			}
			ctx.globalAlpha = 1;
		}

		function frame(now: number) {
			spin();
			project();
			updateGrab();
			step(now);
			project();
			draw();
			raf = requestAnimationFrame(frame);
		}

		function onMove(e: PointerEvent) {
			const r = cv.getBoundingClientRect();
			const pad = 30;
			ptr.x = e.clientX - r.left;
			ptr.y = e.clientY - r.top;
			ptr.near = e.clientX > r.left - pad && e.clientX < r.right + pad && e.clientY > r.top - pad && e.clientY < r.bottom + pad;
		}

		// Let the chain relax before the first frame so it already fills the nucleus.
		function settle() {
			for (let i = 0; i < 260; i++) step(0);
		}

		readBg();
		size();
		seed();
		settle();
		new MutationObserver(() => {
			readBg();
			if (still) draw();
		}).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

		if (still) {
			spin();
			project();
			draw();
		} else {
			window.addEventListener('pointermove', onMove, { passive: true });
			window.addEventListener('pointerdown', onMove, { passive: true });
			window.addEventListener('blur', () => (ptr.near = false));
			// Only animate while the nucleus is on screen.
			new IntersectionObserver(([entry]) => {
				cancelAnimationFrame(raf);
				if (entry.isIntersecting) raf = requestAnimationFrame(frame);
			}).observe(cv);
		}

		let tid: ReturnType<typeof setTimeout>;
		window.addEventListener('resize', () => {
			clearTimeout(tid);
			tid = setTimeout(() => {
				size();
				seed();
				settle();
				if (still) {
					project();
					draw();
				}
			}, 150);
		});
	}
</script>

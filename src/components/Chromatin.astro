---
// A condensed (mitotic) chromosome inside a round "nucleus": two tightly coiled
// sister chromatids joined at the centromere. Hovering pulls the chromatids
// apart and lets them unwind into loose chromatin; the strand nearest the
// cursor follows it. Moving away lets the chromosome condense again.
import { currentSites } from '../lib/data';

const hex = (c: string | undefined, fallback: number[]) => {
	const m = c?.match(/^#?([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i);
	return m ? m.slice(1).map((h) => parseInt(h, 16)) : fallback;
};
const colors = [hex(currentSites[0]?.color, [91, 134, 232]), hex(currentSites[1]?.color, [229, 164, 74])];
---

<div class="nucleus" aria-hidden="true">
	<canvas id="chromatin" data-colors={JSON.stringify(colors)}></canvas>
</div>

<style>
	.nucleus {
		--nucleus-bg: #f3f6fb;
		width: 300px;
		height: 300px;
		max-width: 100%;
		aspect-ratio: 1;
		margin: 0 auto;
		border-radius: 50%;
		background: radial-gradient(circle at 35% 30%, var(--color-bg) 0%, var(--nucleus-bg) 70%);
		border: 6px solid var(--color-bg);
		box-shadow: 0 0 0 1px var(--color-border), var(--shadow-lg);
		overflow: hidden;
	}
	:global([data-theme='dark']) .nucleus {
		--nucleus-bg: #16213a;
	}
	canvas {
		display: block;
		cursor: grab;
		width: 100%;
		height: 100%;
	}
	@media (max-width: 768px) {
		.nucleus {
			width: 220px;
			height: 220px;
		}
	}
</style>

<script>
	const cv = document.getElementById('chromatin') as HTMLCanvasElement | null;
	if (cv) start(cv);

	function start(cv: HTMLCanvasElement) {
		const ctx = cv.getContext('2d')!;
		const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const [CA, CB] = JSON.parse(cv.dataset.colors || '[[91,134,232],[229,164,74]]') as number[][];

		const N = 230; // beads per chromatid
		const CHAINS = [-1, 1]; // left and right sister chromatids
		const COILS = 30; // helical turns per condensed chromatid
		const FOCAL = 900;
		const GRAB_R = 50; // px: how close the cursor must come to grab a strand
		const SPAN = 22; // beads either side of the grabbed one that get pulled

		type Bead = { x: number; y: number; z: number; vx: number; vy: number; vz: number; sx: number; sy: number; zv: number; sc: number; tx: number; ty: number; tz: number };
		const beads: Bead[] = []; // chain c occupies [c*N, c*N + N)
		const ptr = { x: 0, y: 0, inside: false, near: false };
		const grab = { i: -1, amt: 0 };

		let BG = [243, 246, 251];
		let w = 0, h = 0, R = 100;
		let raf = 0;
		let open = 0; // 0 = condensed chromosome, 1 = pulled apart
		let yaw = 0, tilt = 0, cy = 1, sy = 0, ct = 1, st = 0;
		let touchTimer: ReturnType<typeof setTimeout> | undefined;

		const clamp = (v: number, a: number, b: number) => (v < a ? a : v > b ? b : v);
		const ease = (t: number) => t * t * (3 - 2 * t);

		function readBg() {
			const probe = getComputedStyle(cv.parentElement!).getPropertyValue('--nucleus-bg').trim();
			const m = probe.match(/^#([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i);
			if (m) BG = m.slice(1).map((x) => parseInt(x, 16));
		}

		function size() {
			const r = cv.getBoundingClientRect();
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			w = r.width;
			h = r.height;
			cv.width = Math.round(w * dpr);
			cv.height = Math.round(h * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			R = Math.min(w, h) * 0.4; // usable radius inside the nuclear envelope
		}

		// Condensed shape: each chromatid is a tight helix wound around a curved
		// axis, ")(" style, pinched together at the centromere.
		function condensed(c: number, i: number) {
			const t = i / (N - 1);
			const u = (t - 0.5) * 2; // -1 top … 1 bottom
			const Y = u * R * 0.86;
			const axisX = c * (R * 0.1 + R * 0.26 * u * u);
			const radius = R * (0.07 + 0.08 * Math.min(1, Math.abs(u) * 2.2)) * Math.sqrt(Math.max(0, 1 - Math.pow(Math.abs(u), 6))); // pinched centromere, rounded ends
			const phi = t * COILS * Math.PI * 2 * c;
			return { x: axisX + Math.cos(phi) * radius, y: Y, z: Math.sin(phi) * radius };
		}

		// Pulled-apart shape: each chromatid drifts to its own side of the nucleus
		// and unwinds into a loose, irregular coil.
		function decondensed(c: number, i: number) {
			const t = i / (N - 1);
			const th = 0.35 + t * (Math.PI - 0.7);
			const ph = t * 4 * Math.PI * 2 + (c > 0 ? Math.PI : 0);
			const r = R * (0.36 + 0.1 * Math.sin(i * 0.19) + 0.05 * Math.sin(i * 0.53 + c));
			return {
				x: c * R * 0.46 + Math.sin(th) * Math.cos(ph) * r * 0.9,
				y: -Math.cos(th) * R * 0.78 + Math.sin(i * 0.12) * R * 0.06,
				z: Math.sin(th) * Math.sin(ph) * r,
			};
		}

		function retarget() {
			const k = ease(open);
			CHAINS.forEach((c, ci) => {
				for (let i = 0; i < N; i++) {
					const a = condensed(c, i), b = decondensed(c, i);
					const p = beads[ci * N + i];
					p.tx = a.x + (b.x - a.x) * k;
					p.ty = a.y + (b.y - a.y) * k;
					p.tz = a.z + (b.z - a.z) * k;
				}
			});
		}

		function seed() {
			beads.length = 0;
			CHAINS.forEach((c) => {
				for (let i = 0; i < N; i++) {
					const a = condensed(c, i);
					beads.push({ ...a, vx: 0, vy: 0, vz: 0, sx: 0, sy: 0, zv: 0, sc: 1, tx: a.x, ty: a.y, tz: a.z });
				}
			});
		}

		function spin(now: number) {
			// A gentle sway rather than a full turn, so the X stays readable.
			yaw = 0.35 * Math.sin(now * 0.00032) * (1 - 0.6 * grab.amt);
			tilt = 0.12 * Math.sin(now * 0.00021);
			cy = Math.cos(yaw);
			sy = Math.sin(yaw);
			ct = Math.cos(tilt);
			st = Math.sin(tilt);
		}

		function project() {
			for (const p of beads) {
				const x1 = p.x * cy + p.z * sy;
				const z1 = -p.x * sy + p.z * cy;
				const y2 = p.y * ct - z1 * st;
				const z2 = p.y * st + z1 * ct;
				const s = FOCAL / (FOCAL + z2);
				p.zv = z2;
				p.sc = s;
				p.sx = w / 2 + x1 * s;
				p.sy = h / 2 + y2 * s;
			}
		}

		function unproject(dsx: number, dsy: number, s: number) {
			const dvx = dsx / s, dvy = dsy / s;
			const y1 = dvy * ct, z1 = -dvy * st;
			return { x: dvx * cy - z1 * sy, y: y1, z: dvx * sy + z1 * cy };
		}

		function updateGrab() {
			if (!ptr.near) {
				grab.amt += (0 - grab.amt) * 0.08;
				if (grab.amt < 0.01) grab.i = -1;
				return;
			}
			let best = -1, bestD = GRAB_R * GRAB_R;
			if (grab.i >= 0) {
				const p = beads[grab.i];
				if ((ptr.x - p.sx) ** 2 + (ptr.y - p.sy) ** 2 < (GRAB_R * 2.2) ** 2) best = grab.i; // keep hold
			}
			if (best < 0) {
				beads.forEach((p, i) => {
					const d = (ptr.x - p.sx) ** 2 + (ptr.y - p.sy) ** 2;
					if (d < bestD) { bestD = d; best = i; }
				});
			}
			if (best >= 0) grab.i = best;
			grab.amt += ((best >= 0 ? 1 : 0) - grab.amt) * 0.1;
			cv.style.cursor = best >= 0 && grab.amt > 0.4 ? 'grabbing' : '';
		}

		// How strongly bead j is held by the cursor (0…1).
		function held(j: number) {
			if (grab.i < 0 || grab.amt < 0.01) return 0;
			const same = Math.floor(j / N) === Math.floor(grab.i / N);
			const k = Math.abs(j - grab.i);
			if (!same || k > SPAN) return 0;
			return grab.amt * (0.5 + 0.5 * Math.cos((Math.PI * k) / (SPAN + 1)));
		}

		function step() {
			const target = ptr.inside ? 1 : 0;
			open += (target - open) * (target ? 0.03 : 0.012);
			retarget();

			const loose = ease(open);
			const pull = 0.05 - 0.03 * loose; // springs to the shape: firm when condensed
			const heat = 0.06 + 0.16 * loose;

			// bonds follow the spacing of the current shape
			for (let c = 0; c < CHAINS.length; c++) {
				for (let i = c * N; i < c * N + N - 1; i++) {
					const a = beads[i], b = beads[i + 1];
					const L = Math.hypot(b.tx - a.tx, b.ty - a.ty, b.tz - a.tz);
					let dx = b.x - a.x, dy = b.y - a.y, dz = b.z - a.z;
					const d = Math.sqrt(dx * dx + dy * dy + dz * dz) || 1e-6;
					const f = (d - L) * 0.25;
					dx /= d; dy /= d; dz /= d;
					a.vx += dx * f; a.vy += dy * f; a.vz += dz * f;
					b.vx -= dx * f; b.vy -= dy * f; b.vz -= dz * f;
				}
			}

			// bending stiffness keeps the loose fibre smooth
			const bend = 0.05 * loose;
			if (bend > 0) {
				for (let j = 1; j < beads.length - 1; j++) {
					if (j % N === 0 || (j + 1) % N === 0) continue;
					const p = beads[j - 1], c = beads[j], n = beads[j + 1];
					c.vx += ((p.x + n.x) / 2 - c.x) * bend;
					c.vy += ((p.y + n.y) / 2 - c.y) * bend;
					c.vz += ((p.z + n.z) / 2 - c.z) * bend;
				}
			}

			// excluded volume, only once the chromatin loosens
			if (loose > 0.05) {
				const Rx = R * 0.07;
				for (let i = 0; i < beads.length; i++) {
					for (let j = i + 3; j < beads.length; j++) {
						const a = beads[i], b = beads[j];
						let dx = b.x - a.x, dy = b.y - a.y, dz = b.z - a.z;
						const d2 = dx * dx + dy * dy + dz * dz;
						if (d2 < Rx * Rx && d2 > 1e-6) {
							const d = Math.sqrt(d2), f = (Rx - d) * 0.04 * loose;
							dx /= d; dy /= d; dz /= d;
							a.vx -= dx * f; a.vy -= dy * f; a.vz -= dz * f;
							b.vx += dx * f; b.vy += dy * f; b.vz += dz * f;
						}
					}
				}
			}

			const g = grab.i >= 0 ? beads[grab.i] : null;
			let pullTo = { x: 0, y: 0, z: 0 };
			if (g && grab.amt > 0.01) {
				let dsx = ptr.x - g.sx, dsy = ptr.y - g.sy;
				const ds = Math.hypot(dsx, dsy);
				if (ds > 140) { dsx *= 140 / ds; dsy *= 140 / ds; }
				pullTo = unproject(dsx, dsy, g.sc);
			}

			beads.forEach((p, j) => {
				const hold = held(j);
				const k = pull * (1 - 0.85 * hold); // a held strand is free to leave the shape
				p.vx += (p.tx - p.x) * k;
				p.vy += (p.ty - p.y) * k;
				p.vz += (p.tz - p.z) * k;
				if (hold) {
					p.vx += pullTo.x * 0.09 * hold;
					p.vy += pullTo.y * 0.09 * hold;
					p.vz += pullTo.z * 0.09 * hold;
				}
				p.vx += (Math.random() - 0.5) * heat;
				p.vy += (Math.random() - 0.5) * heat;
				p.vz += (Math.random() - 0.5) * heat;

				// nuclear envelope
				const r = Math.hypot(p.x, p.y, p.z) / (R * 1.08);
				if (r > 1) {
					const f = (r - 1) * 1.5;
					p.vx -= (p.x / (r * R)) * f * R * 0.1;
					p.vy -= (p.y / (r * R)) * f * R * 0.1;
					p.vz -= (p.z / (r * R)) * f * R * 0.1;
				}
				p.vx *= 0.82; p.vy *= 0.82; p.vz *= 0.82;
				p.x += p.vx; p.y += p.vy; p.z += p.vz;
			});
		}

		function draw() {
			ctx.clearRect(0, 0, w, h);
			const segs: number[] = [];
			for (let j = 0; j < beads.length - 1; j++) if ((j + 1) % N) segs.push(j);
			segs.sort((a, b) => beads[b].zv + beads[b + 1].zv - (beads[a].zv + beads[a + 1].zv));
			const loose = ease(open);
			ctx.lineCap = 'round';
			ctx.lineJoin = 'round';
			for (const glow of [true, false]) {
				for (const j of segs) {
					const a = beads[j], b = beads[j + 1];
					const dep = clamp((R - (a.zv + b.zv) / 2) / (2 * R), 0, 1); // 1 near, 0 far
					const t = (j % N) / (N - 2);
					const hold = held(j);
					const fade = (1 - dep) * 0.45;
					const col = [0, 1, 2].map((c) => {
						const base = CA[c] + (CB[c] - CA[c]) * t;
						return Math.round(base + (BG[c] - base) * fade);
					});
					const core = (3.2 - 1.5 * loose) * (0.6 + 0.7 * dep) * (1 + 0.6 * hold);
					ctx.strokeStyle = `rgb(${col.join(',')})`;
					ctx.lineWidth = glow ? core * (3.6 - 1.2 * loose) : core;
					ctx.globalAlpha = glow ? (0.07 + 0.08 * dep) * (1 - 0.4 * loose) : (0.65 + 0.35 * dep) * (1 + 0.3 * hold);
					ctx.beginPath();
					ctx.moveTo(a.sx, a.sy);
					ctx.lineTo(b.sx, b.sy);
					ctx.stroke();
				}
			}
			ctx.globalAlpha = 1;
		}

		function frame(now: number) {
			spin(now);
			project();
			updateGrab();
			step();
			project();
			draw();
			raf = requestAnimationFrame(frame);
		}

		function onMove(e: PointerEvent) {
			const r = cv.getBoundingClientRect();
			ptr.x = e.clientX - r.left;
			ptr.y = e.clientY - r.top;
			const d = Math.hypot(ptr.x - w / 2, ptr.y - h / 2);
			const inside = d < w / 2 + 12;
			if (e.pointerType === 'mouse') {
				ptr.inside = inside;
				ptr.near = inside;
			} else if (inside) {
				// Touch: a tap pulls it apart for a few seconds.
				ptr.inside = ptr.near = true;
				clearTimeout(touchTimer);
				touchTimer = setTimeout(() => (ptr.inside = ptr.near = false), 3500);
			}
		}

		readBg();
		size();
		seed();
		new MutationObserver(() => {
			readBg();
			if (still) draw();
		}).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

		if (still) {
			spin(0);
			project();
			draw();
		} else {
			window.addEventListener('pointermove', onMove, { passive: true });
			window.addEventListener('pointerdown', onMove, { passive: true });
			document.documentElement.addEventListener('pointerleave', () => (ptr.inside = ptr.near = false));
			window.addEventListener('blur', () => (ptr.inside = ptr.near = false));
			// Only animate while the nucleus is on screen.
			new IntersectionObserver(([entry]) => {
				cancelAnimationFrame(raf);
				if (entry.isIntersecting) raf = requestAnimationFrame(frame);
			}).observe(cv);
		}

		let tid: ReturnType<typeof setTimeout>;
		window.addEventListener('resize', () => {
			clearTimeout(tid);
			tid = setTimeout(() => {
				size();
				seed();
				if (still) {
					project();
					draw();
				}
			}, 150);
		});
	}
</script>

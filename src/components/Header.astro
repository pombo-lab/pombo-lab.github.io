---
import BrandMark from './BrandMark.astro';
import { settings } from '../lib/data';
import { NAV, type NavItem } from '../lib/nav';
import { url } from '../utils/paths';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const here = (Astro.url.pathname.slice(base.length) || '/').replace(/(.)\/+$/, '$1');
const isHere = (href: string) => href === here;
const isActive = (item: NavItem) =>
	isHere(item.href) ||
	(item.href !== '/' && here.startsWith(`${item.href}/`)) ||
	!!item.children?.some((c) => isHere(c.href));
---

<header class="site-header">
	<nav aria-label="Main">
		<a class="brand" href={url('/')}>
			<BrandMark />
			<span>
				{settings.labName}
				{settings.tagline && <small>{settings.tagline}</small>}
			</span>
		</a>

		<div class="internal-links">
			{NAV.map((item) =>
				item.children ? (
					<div class="dropdown">
						<a href={url(item.href)} class:list={['dropbtn', { active: isActive(item) }]} aria-haspopup="true">
							{item.label}
							<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
						</a>
						<div class="dropdown-content">
							{item.children.map((c) => (
								<a href={url(c.href)} class:list={{ current: isHere(c.href) }} aria-current={isHere(c.href) ? 'page' : undefined}>{c.label}</a>
							))}
						</div>
					</div>
				) : (
					<a href={url(item.href)} class:list={{ active: isActive(item) }} aria-current={isHere(item.href) ? 'page' : undefined}>{item.label}</a>
				),
			)}
		</div>

		<div class="header-actions">
			<button id="search-toggle-desktop" class="search-toggle icon-btn" aria-label="Search site" title="Search (press /)">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
			</button>
			<button id="theme-toggle" class="icon-btn" aria-label="Toggle dark mode">
				<svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
				<svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
			</button>
			<button id="menu-toggle" class="icon-btn" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
			</button>
		</div>
	</nav>

	<div id="mobile-menu" class="mobile-menu hidden">
		<div class="mobile-menu-header">
			<span class="mobile-menu-title">Menu</span>
			<button id="search-toggle-mobile" class="search-toggle icon-btn" aria-label="Search site">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
			</button>
		</div>
		{NAV.map((item) =>
			item.children ? (
				<>
					<span class="mobile-menu-section">{item.label}</span>
					<div class="mobile-submenu">
						{item.children.map((c) => (
							<a href={url(c.href)} aria-current={isHere(c.href) ? 'page' : undefined}>{c.label}</a>
						))}
					</div>
				</>
			) : (
				<a href={url(item.href)} aria-current={isHere(item.href) ? 'page' : undefined}>{item.label}</a>
			),
		)}
	</div>
</header>

<script>
	document.getElementById('theme-toggle')?.addEventListener('click', () => {
		const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
		const newTheme = isDark ? 'light' : 'dark';
		(window as any).__setPreferredTheme?.(newTheme);
		try {
			localStorage.setItem('theme', newTheme);
		} catch {}
	});

	const menuBtn = document.getElementById('menu-toggle');
	const menu = document.getElementById('mobile-menu');
	menuBtn?.addEventListener('click', () => {
		const open = !menu?.classList.toggle('hidden');
		menuBtn.setAttribute('aria-expanded', String(open));
		menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
	});
	document.addEventListener('click', (e) => {
		if (!menu || menu.classList.contains('hidden')) return;
		const t = e.target as Node;
		if (!menu.contains(t) && !menuBtn?.contains(t)) {
			menu.classList.add('hidden');
			menuBtn?.setAttribute('aria-expanded', 'false');
		}
	});

	document.querySelectorAll('.search-toggle').forEach((btn) => {
		btn.addEventListener('click', () => {
			document.dispatchEvent(new CustomEvent('open-search'));
		});
	});
</script>

<style>
	header::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		height: 1px;
		background: linear-gradient(90deg, transparent 0%, var(--color-border) 20%, var(--color-border) 80%, transparent 100%);
		opacity: 0.6;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: var(--max-width);
		margin: 0 auto;
		height: 4.5rem;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		color: var(--color-text-main);
		font-weight: 700;
		font-size: 1.15rem;
		letter-spacing: -0.02em;
		line-height: 1.1;
		white-space: nowrap;
		text-decoration: none;
	}
	.brand:hover {
		opacity: 1;
		text-decoration: none;
	}
	.brand small {
		display: block;
		font-weight: 400;
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-muted);
		margin-top: 2px;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.1rem;
	}
	.internal-links > a,
	.dropbtn {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.5em 0.6em;
		color: var(--color-text-main);
		border-bottom: 2px solid transparent;
		text-decoration: none;
		font-size: 0.92rem;
		font-weight: 500;
		transition: all 0.2s ease;
	}
	.internal-links > a:hover,
	.dropdown:hover .dropbtn {
		color: var(--color-accent);
		text-decoration: none;
		opacity: 1;
	}
	.internal-links > a.active,
	.dropbtn.active {
		border-bottom-color: var(--color-accent);
		color: var(--color-accent);
	}
	.dropbtn svg {
		opacity: 0.6;
	}

	.dropdown {
		position: relative;
		display: inline-block;
	}
	.dropdown-content {
		display: none;
		position: absolute;
		background-color: var(--color-bg-mobile-menu);
		backdrop-filter: blur(40px) saturate(150%);
		-webkit-backdrop-filter: blur(40px) saturate(150%);
		min-width: 190px;
		box-shadow: 0px 8px 16px 0px rgba(0, 0, 0, 0.2);
		z-index: 1;
		border-radius: 8px;
		overflow: hidden;
		border: 1px solid var(--color-header-border);
		top: 100%;
		left: 50%;
		transform: translateX(-50%);
	}
	.dropdown-content a {
		color: var(--color-text-main);
		padding: 10px 16px;
		text-decoration: none;
		display: block;
		font-size: 0.92rem;
		white-space: nowrap;
	}
	.dropdown-content a:hover {
		background-color: var(--color-accent-light);
		opacity: 1;
	}
	.dropdown-content a.current {
		color: var(--color-accent);
		font-weight: 700;
	}
	.dropdown:hover .dropdown-content,
	.dropdown:focus-within .dropdown-content {
		display: block;
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}
	.icon-btn {
		background: transparent;
		border: none;
		cursor: pointer;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-text-main);
		transition: background-color 0.2s ease;
	}
	.icon-btn:hover {
		background-color: var(--color-accent-light);
		color: var(--color-accent);
	}

	.mobile-menu-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-bottom: 0.25rem;
		border-bottom: 1px solid var(--color-border);
		margin-bottom: 0.25rem;
	}
	.mobile-menu-title {
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--color-text-muted);
		padding-left: 0.5rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	#menu-toggle {
		display: none;
	}

	.mobile-menu {
		position: absolute;
		top: calc(100% + 0.5rem);
		right: 1rem;
		width: fit-content;
		min-width: 220px;
		max-height: calc(100vh - 6rem);
		overflow-y: auto;
		background-color: var(--color-bg-mobile-menu);
		backdrop-filter: blur(40px) saturate(150%);
		-webkit-backdrop-filter: blur(40px) saturate(150%);
		border: 1px solid var(--color-header-border);
		border-radius: 12px;
		padding: 0.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12), 0 2px 8px rgba(0, 0, 0, 0.08);
		z-index: 200;
		animation: menuFadeIn 0.2s ease;
	}
	@keyframes menuFadeIn {
		from { opacity: 0; transform: translateY(-8px) scale(0.96); }
		to { opacity: 1; transform: translateY(0) scale(1); }
	}
	.mobile-menu a {
		padding: 0.5rem 0.875rem;
		text-decoration: none;
		color: var(--color-text-main);
		font-weight: 500;
		font-size: 0.95rem;
		border-radius: 8px;
		transition: background-color 0.2s, color 0.2s;
	}
	.mobile-menu a:hover,
	.mobile-menu a[aria-current='page'] {
		background-color: var(--color-accent-light);
		color: var(--color-accent);
		opacity: 1;
	}
	.mobile-menu-section {
		padding: 0.75rem 0.875rem 0.4rem;
		font-weight: 600;
		font-size: 0.8rem;
		color: var(--color-text-muted);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-top: 0.25rem;
		border-top: 1px solid var(--color-border);
	}
	.mobile-submenu {
		display: flex;
		flex-direction: column;
		padding-left: 0.5rem;
		border-left: 2px solid var(--color-border);
		margin-left: 1rem;
		margin-bottom: 0.25rem;
	}
	.hidden {
		display: none;
	}

	.moon-icon { display: none; }
	.sun-icon { display: block; }
	:global(html[data-theme='dark']) .moon-icon { display: block; }
	:global(html[data-theme='dark']) .sun-icon { display: none; }

	@media (min-width: 881px) {
		.mobile-menu { display: none !important; }
	}
	@media (max-width: 880px) {
		.internal-links { display: none; }
		#menu-toggle { display: flex; }
		#search-toggle-desktop { display: none !important; }
	}
</style>

---
import PageHeader from '../components/PageHeader.astro';
import Page from '../layouts/Page.astro';
import { asset, lab, settings } from '../lib/data';
import { inline } from '../utils/text';

// Newest first; undated photos go in a final group.
const photos = [...lab.gallery].sort((a, b) => (b.date || '').localeCompare(a.date || ''));
const groups: { year: string; photos: typeof photos }[] = [];
for (const p of photos) {
	const year = p.date ? p.date.slice(0, 4) : 'More';
	const g = groups.at(-1);
	if (g?.year === year) g.photos.push(p);
	else groups.push({ year, photos: [p] });
}
const monthYear = (iso: string) =>
	new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const heading = (p: (typeof photos)[number]) =>
	[p.title, p.date && (p.title ? `(${monthYear(p.date)})` : monthYear(p.date))].filter(Boolean).join(' ');
// Plain text for alt text.
const plain = (s: string) => s.replace(/\[([^\]]+)\]\([^)]*\)/g, '$1').replace(/\*\*/g, '');
---

<Page title="Gallery" description={`Photos from the ${settings.labName}.`}>
	<PageHeader eyebrow="Life in the lab" title="Gallery" intro={settings.galleryIntro} />

	{photos.length === 0 && <p class="empty-note">Photos are coming soon.</p>}

	{groups.length > 1 && (
		<nav class="year-pills" aria-label="Jump to year">
			{groups.map((g) => <a href={`#year-${g.year}`} data-year={g.year}>{g.year}</a>)}
		</nav>
	)}

	<div class="timeline">
		<div class="years">
			{groups.map((g) => (
				<section id={`year-${g.year}`} class="year">
					<h2>{g.year}</h2>
					{g.photos.map((p) => (
						<figure class="photo">
							{heading(p) && <h3>{heading(p)}</h3>}
							{p.caption && <p class="subtitle" set:html={inline(p.caption)} />}
							<a href={asset(p.image)} target="_blank" rel="noopener noreferrer">
								<img src={asset(p.image)} alt={plain(heading(p) || p.caption)} loading="lazy" decoding="async" />
								<span class="sr-only">(opens in new tab)</span>
							</a>
							{p.credit && <figcaption set:html={inline(p.credit)} />}
						</figure>
					))}
				</section>
			))}
		</div>

		{groups.length > 1 && (
			<nav class="year-nav" aria-label="Year navigation">
				<p>Years</p>
				{groups.map((g) => <a href={`#year-${g.year}`} data-year={g.year}>{g.year}</a>)}
			</nav>
		)}
	</div>
</Page>

<script>
	// Highlight the year currently in view, in both the sidebar and the phone pill bar.
	const sections = [...document.querySelectorAll<HTMLElement>('.year')];
	const links = [...document.querySelectorAll<HTMLAnchorElement>('.year-nav a, .year-pills a')];
	const pills = document.querySelector<HTMLElement>('.year-pills');
	let active = '';

	function update() {
		const line = 160;
		let current = sections.find((s) => {
			const r = s.getBoundingClientRect();
			return r.top <= line && r.bottom > line;
		});
		if (!current && sections.length && sections[0].getBoundingClientRect().top > line) current = sections[0];
		if (!current && sections.length) current = sections[sections.length - 1];
		const year = current?.id.replace('year-', '') || '';
		if (year === active) return;
		active = year;
		for (const a of links) {
			const on = a.dataset.year === year;
			a.classList.toggle('active', on);
			if (on) a.setAttribute('aria-current', 'true');
			else a.removeAttribute('aria-current');
			if (on && pills?.contains(a)) pills.scrollTo({ left: a.offsetLeft - pills.offsetWidth / 2 + a.offsetWidth / 2, behavior: 'smooth' });
		}
	}
	if (sections.length) {
		addEventListener('scroll', update, { passive: true });
		update();
	}
</script>

<style>
	.timeline {
		display: flex;
		gap: 2rem;
		align-items: flex-start;
	}
	.years {
		flex: 1;
		min-width: 0;
	}
	.year {
		scroll-margin-top: 6rem;
		margin-bottom: 4rem;
	}
	.year h2 {
		display: block;
		width: 100%;
		font-size: 1.6rem;
		padding-bottom: 0.5rem;
		margin-bottom: 1.5rem;
		border-bottom: 2px solid var(--color-accent);
	}
	.photo {
		margin: 0 0 2.75rem;
		text-align: center;
	}
	.photo h3 {
		font-family: inherit;
		font-size: 1.1rem;
		font-weight: 600;
		color: var(--color-text-main);
		margin-bottom: 0.4rem;
	}
	.photo .subtitle {
		color: var(--color-text-muted);
		margin: 0 0 0.75rem;
	}
	.photo a {
		display: block;
	}
	.photo img {
		display: block;
		max-width: 100%;
		max-height: 600px;
		width: auto;
		height: auto;
		margin: 0 auto;
		border-radius: 8px;
		box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
		transition: box-shadow 0.2s ease;
	}
	.photo a:hover img,
	.photo a:focus-visible img {
		box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.15), 0 8px 10px -6px rgb(0 0 0 / 0.15);
	}
	.photo figcaption {
		margin-top: 0.5rem;
		font-size: 0.9rem;
		color: var(--color-text-muted);
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	/* Desktop: sticky list of years on the right */
	.year-nav {
		position: sticky;
		top: 6rem;
		flex: 0 0 7rem;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}
	.year-nav p {
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-text-muted);
		margin: 0 0 0.5rem;
		padding-left: 0.9rem;
	}
	.year-nav a,
	.year-pills a {
		color: var(--color-text-muted);
		text-decoration: none;
		transition: all 0.15s ease;
	}
	.year-nav a {
		padding: 0.55rem 0.9rem;
		border-radius: 8px;
		font-size: 1.05rem;
		font-weight: 500;
	}
	.year-nav a:hover {
		color: var(--color-accent);
		background: var(--color-accent-light);
	}
	.year-nav a.active {
		color: var(--color-bg);
		background: var(--color-accent);
	}

	/* Phones: scrolling row of year pills under the header */
	.year-pills {
		display: none;
	}
	@media (max-width: 768px) {
		.year-nav {
			display: none;
		}
		.year-pills {
			display: flex;
			gap: 0.4rem;
			overflow-x: auto;
			scrollbar-width: none;
			position: sticky;
			top: 72px;
			z-index: 10;
			margin: 0 -1rem 1.5rem;
			padding: 0.5rem 1rem;
			background: var(--color-bg);
			border-bottom: 1px solid var(--color-border);
		}
		.year-pills::-webkit-scrollbar {
			display: none;
		}
		.year-pills a {
			flex-shrink: 0;
			padding: 0.35rem 0.9rem;
			font-size: 0.85rem;
			border: 1px solid var(--color-border);
			border-radius: 999px;
		}
		.year-pills a.active {
			background: var(--color-accent);
			border-color: var(--color-accent);
			color: var(--color-bg);
		}
		.year {
			scroll-margin-top: 8rem;
		}
	}
</style>

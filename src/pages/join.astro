---
import PageHeader from '../components/PageHeader.astro';
import Page from '../layouts/Page.astro';
import { lab, settings } from '../lib/data';
import { inline, paragraphs } from '../utils/text';
---

<Page title={settings.joinTitle || 'Join'} description={paragraphs(settings.joinIntro)[0]}>
	<PageHeader eyebrow="Opportunities" title={settings.joinTitle || 'Join the lab'} intro={settings.joinIntro} />

	<div class="join-sections">
		{lab.join.map((s) => (
			<section class="card">
				<h2>{s.heading}</h2>
				{paragraphs(s.text).map((p) => <p set:html={inline(p)} />)}
			</section>
		))}
		<section class="card contact">
			<h2>Contact</h2>
			<p>Write to <a href={`mailto:${lab.pi.email}`}>{lab.pi.email}</a> with a short note about your interests and your CV.</p>
		</section>
	</div>
</Page>

<style>
	.join-sections {
		display: grid;
		gap: 1.25rem;
		max-width: 760px;
	}
	.join-sections h2 {
		font-size: 1.35rem;
		margin: 0 0 0.75rem;
		border: none;
		padding: 0;
		display: block;
		color: var(--color-accent);
	}
	.join-sections p {
		font-size: 1rem;
		margin-bottom: 0.6rem;
	}
	.join-sections p:last-child {
		margin-bottom: 0;
	}
	.contact {
		border-left: 4px solid var(--color-accent);
	}
</style>

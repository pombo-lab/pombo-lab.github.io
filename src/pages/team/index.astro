---
import MemberCard from '../../components/MemberCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import Page from '../../layouts/Page.astro';
import { asset, currentSites, lab, settings } from '../../lib/data';
import { generateFallbackAvatar } from '../../utils/avatar';
import { inline, paragraphs } from '../../utils/text';
import { url } from '../../utils/paths';

const pi = lab.pi;
const piFallback = generateFallbackAvatar(pi.name);
const sections = currentSites
	.map((site) => ({ site, members: lab.members.filter((m) => m.site === site.code) }))
	.filter((s) => s.members.length);
---

<Page title="Team" description={`Members of the ${settings.labName}.`}>
	<PageHeader eyebrow="People" title="Research Team" intro={settings.teamIntro} />

	<a class="pi-card" href={url('/team/pi')}>
		<img
			src={asset(pi.photo) || piFallback}
			alt={pi.name}
			width="160"
			height="160"
			onerror={`this.onerror=null;this.src='${piFallback}'`}
		/>
		<div class="pi-info">
			<p class="eyebrow">Principal Investigator</p>
			<h2>{pi.name}</h2>
			<span class="pi-title">{pi.title}</span>
			{paragraphs(pi.bio[0]).slice(0, 1).map((p) => <p set:html={inline(p)} />)}
			<span class="more-link">Full profile &rarr;</span>
		</div>
	</a>

	{currentSites.length > 1 && sections.length > 1 && (
		<nav class="chips site-jump" aria-label="Jump to site">
			{sections.map(({ site }) => (
				<a class="chip" href={`#${site.code.toLowerCase()}`}>{site.short || site.code} · {site.address}</a>
			))}
		</nav>
	)}

	{sections.map(({ site, members }) => (
		<section class="site-section" id={site.code.toLowerCase()} style={site.color ? `--site: ${site.color}` : undefined}>
			<div class="site-head">
				<h2>{site.name}</h2>
				<p>
					{paragraphs(site.department).join(' · ')}
					{site.address && <><br /><span class="site-address">{site.address}</span></>}
				</p>
			</div>
			<div class="grid-3 team-grid">
				{members.map((m) => <MemberCard member={m} />)}
			</div>
		</section>
	))}

	{lab.alumni.length > 0 && (
		<a class="card alumni-link" href={url('/team/alumni')}>
			<h3>Alumni</h3>
			<p>{lab.alumni.length} former members — see where they are now &rarr;</p>
		</a>
	)}
</Page>

<style>
	.pi-card {
		display: flex;
		gap: 2.5rem;
		align-items: center;
		padding: 2.5rem;
		background-color: var(--color-bg-offset);
		border: 1px solid var(--color-border);
		border-radius: 16px;
		margin-bottom: 2.5rem;
		color: var(--color-text-main);
		transition: border-color 0.3s ease, box-shadow 0.3s ease;
	}
	.pi-card:hover {
		border-color: var(--color-accent);
		box-shadow: var(--shadow-md);
		text-decoration: none;
		opacity: 1;
	}
	.pi-card img {
		width: 160px;
		height: 160px;
		border-radius: 50%;
		object-fit: cover;
		border: 4px solid var(--color-accent-light);
		flex-shrink: 0;
	}
	.pi-info h2 {
		font-size: 1.8rem;
		margin: 0 0 0.25rem;
		border: none;
		padding: 0;
	}
	.pi-info .eyebrow {
		margin-bottom: 0.4rem;
	}
	.pi-title {
		color: var(--color-accent);
		font-weight: 600;
		display: block;
		margin-bottom: 0.75rem;
	}
	.pi-info p:not(.eyebrow) {
		line-height: 1.7;
		margin: 0 0 0.75rem;
		font-size: 0.98rem;
	}
	.site-jump .chip {
		text-decoration: none;
	}
	.site-section {
		scroll-margin-top: 5.5rem;
		margin-top: 2.5rem;
	}
	.site-head h2 {
		border-bottom-color: var(--site, var(--color-accent));
		margin-bottom: 0.5rem;
	}
	.site-head p {
		font-size: 0.92rem;
		margin: 0;
	}
	.site-address {
		font-weight: 700;
		color: var(--site, var(--color-accent));
	}
	.team-grid {
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
		gap: 1rem;
	}
	.team-grid :global(.team-avatar) {
		border-color: color-mix(in srgb, var(--site, var(--color-accent)) 25%, transparent);
	}
	.team-grid :global(.team-role) {
		color: var(--site, var(--color-accent));
	}
	.alumni-link {
		margin-top: 3rem;
	}
	@media (max-width: 768px) {
		.pi-card {
			flex-direction: column;
			text-align: center;
			padding: 2rem 1.5rem;
		}
		.pi-card img {
			width: 120px;
			height: 120px;
		}
	}
</style>

---
import PageHeader from '../../components/PageHeader.astro';
import Page from '../../layouts/Page.astro';
import { asset, lab, type ResearchArea } from '../../lib/data';
import { inline, paragraphs } from '../../utils/text';
import { url } from '../../utils/paths';

export function getStaticPaths() {
	return lab.research.map((area, i) => ({
		params: { slug: area.slug },
		props: { area, prev: lab.research[i - 1], next: lab.research[i + 1] },
	}));
}

interface Props {
	area: ResearchArea;
	prev?: ResearchArea;
	next?: ResearchArea;
}

const { area, prev, next } = Astro.props;
const image = asset(area.image);
const hasAside = !!(area.kicker || image || area.collaborators || area.funding);
---

<Page title={area.title} description={area.summary} image={area.image || undefined}>
	<nav class="crumbs" aria-label="Breadcrumb">
		<a href={url('/research')}>Research</a> / <span>Area {area.number}</span>
	</nav>
	<PageHeader title={area.title} intro={area.summary} />

	<div class:list={['area-layout', { solo: !hasAside }]}>
		{hasAside && <aside class="area-aside">
			{area.kicker && (
				<>
					<p class="eyebrow">Focus</p>
					<p class="kicker">{area.kicker}</p>
				</>
			)}
			{image && (
				<figure>
					<img src={image} alt={area.figure || area.title} loading="lazy" />
					{area.figure && <figcaption>{area.figure}</figcaption>}
				</figure>
			)}
			{area.collaborators && (
				<>
					<p class="eyebrow">Collaborators</p>
					{paragraphs(area.collaborators).map((p) => <p class="aside-text" set:html={inline(p)} />)}
				</>
			)}
			{area.funding && (
				<>
					<p class="eyebrow">Funding</p>
					{paragraphs(area.funding).map((p) => <p class="aside-text" set:html={inline(p)} />)}
				</>
			)}
		</aside>}

		<div class="area-body">
			{paragraphs(area.body).map((p) => <p set:html={inline(p)} />)}

			{area.highlights.length > 0 && (
				<>
					<h3>What this involves</h3>
					<ul class="bullets">
						{area.highlights.map((h) => <li set:html={inline(h)} />)}
					</ul>
				</>
			)}

			<p><a class="btn btn-outline" href={url('/publications')}>Related publications &rarr;</a></p>
		</div>
	</div>

	<nav class="pager" aria-label="Other research areas">
		{prev ? <a href={url(`/research/${prev.slug}`)}>&larr; {prev.title}</a> : <span></span>}
		{next ? <a href={url(`/research/${next.slug}`)}>{next.title} &rarr;</a> : <span></span>}
	</nav>
</Page>

<style>
	.crumbs {
		font-size: 0.85rem;
		color: var(--color-text-muted);
		margin-bottom: 1rem;
	}
	.area-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr);
		gap: 3rem;
		align-items: start;
	}
	.area-layout.solo {
		grid-template-columns: minmax(0, 1fr);
		max-width: 760px;
	}
	.area-aside {
		position: sticky;
		top: 6rem;
		padding: 1.5rem;
		border: 1px solid var(--color-border);
		border-radius: 12px;
		background: var(--color-bg-offset);
	}
	.area-aside .eyebrow {
		margin: 1.25rem 0 0.4rem;
		color: var(--color-text-muted);
		font-size: 0.72rem;
	}
	.area-aside .eyebrow:first-child {
		margin-top: 0;
	}
	.kicker {
		font-family: var(--font-serif);
		font-size: 1.15rem;
		color: var(--color-text-main);
		margin: 0;
	}
	.aside-text {
		font-size: 0.92rem;
		margin: 0 0 0.4rem;
	}
	figure {
		margin: 1.25rem 0 0;
	}
	figure img {
		border-radius: 8px;
		border: 1px solid var(--color-border);
	}
	figcaption {
		font-size: 0.8rem;
		color: var(--color-text-muted);
		margin-top: 0.4rem;
	}
	.area-body > p {
		color: var(--color-text-main);
		line-height: 1.75;
	}
	.area-body h3 {
		margin-top: 2rem;
	}
	.pager {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--color-border);
		font-weight: 600;
	}
	@media (max-width: 768px) {
		.area-layout {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
		.area-aside {
			position: static;
			order: 2;
		}
	}
</style>
